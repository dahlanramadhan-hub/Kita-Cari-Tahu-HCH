Options -Indexes
RewriteEngine On

# Block private application files and configuration from direct web access.
RewriteRule ^(app|config|database|routes|storage)(/|$) - [F,L,NC]
RewriteRule ^\.env(?:$|/) - [F,L,NC]
RewriteRule ^(README\.md|composer\.json|\.gitignore|KONFIGURASI-DATABASE-HOSTINGER\.txt|UPLOAD-HOSTINGER\.txt|CARA-UPLOAD-PUBLIC_HTML\.txt)$ - [F,L,NC]

# API endpoints.
RewriteRule ^api/index\.php$ - [L]
RewriteRule ^api/?$ api/index.php [QSA,L]
RewriteRule ^api/(.+)$ api/index.php?route=$1 [QSA,L]

# Serve existing files (CSS, JS, images) as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send application pages such as /login to the PHP app shell.
RewriteRule ^ index.php [QSA,L]
